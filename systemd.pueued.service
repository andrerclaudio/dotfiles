# Service file for the pueue daemon (a user unit).
#
# Install:  cp systemd.pueued.service ~/.config/systemd/user/pueued.service
#           systemctl --user daemon-reload
#           systemctl --user enable --now pueued
#
# ExecStart uses %h (the user's home) because pueued is installed by cargo into
# ~/.cargo/bin, not into /usr/bin.

[Unit]
Description=Pueue Daemon - CLI process scheduler and manager
Documentation=https://github.com/Nukesor/pueue

[Service]
Type=simple
Restart=no
ExecStart=%h/.cargo/bin/pueued -vv

[Install]
WantedBy=default.target
