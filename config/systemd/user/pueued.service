# Pueue daemon. extra.sh copies this to ~/.config/systemd/user/ and enables it.
# %h because cargo installs pueued into ~/.cargo/bin.

[Unit]
Description=Pueue Daemon - CLI process scheduler and manager
Documentation=https://github.com/Nukesor/pueue

[Service]
Type=simple
Restart=no
ExecStart=%h/.cargo/bin/pueued -vv

[Install]
WantedBy=default.target
